      "css": ".ds-control{font-family:Inter,\"Segoe UI\",sans-serif;display:grid;justify-items:center;gap:10px;text-align:center;line-height:1.65}.ds-key{display:grid;place-items:center;min-width:65px;height:54px;padding:0 13px;border:1px solid #9db1bb;border-bottom-width:3px;border-radius:5px;background:#e5edf0;font-family:Inter,sans-serif;font-size:18px;font-weight:600;color:var(--ink,#263e4b)}.ds-direction{font-size:13px;color:var(--muted,#496370)}",
      "refersTo": "movement-key"
    },
