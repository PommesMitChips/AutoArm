  "components": [
    {
      "name": "Print action",
      "kind": "button",
      "description": "The guide print affordance, styled as a quiet underlined text action.",
      "html": "<button class=\"ds-print\" type=\"button\">Print guide</button>",
      "css": ".ds-print{font-family:Inter,\"Segoe UI\",sans-serif;border:0;padding:0;background:transparent;color:var(--ink,#263e4b);text-decoration:underline;text-underline-offset:4px;font-size:13px;line-height:1.65;cursor:pointer}.ds-print:focus-visible{outline:3px solid var(--focus,#9e6d20);outline-offset:5px;}@media print{.ds-print{display:none}}",
      "refersTo": "print-action"
    },
    {
      "name": "Resource navigation",
      "kind": "nav",
      "description": "Wrapping guide resource links; no active-tab treatment.",
      "html": "<nav class=\"ds-resources\" aria-label=\"Guide resources\"><a class=\"ds-resource-link\" href=\"#parts-library\">Parts library</a><a class=\"ds-resource-link\" href=\"#guide-download\">Download guide</a></nav>",
      "css": ".ds-resources{font-family:Inter,\"Segoe UI\",sans-serif;display:flex;flex-wrap:wrap;gap:22px;font-size:13px;line-height:1.65}.ds-resource-link{color:var(--ink,#263e4b);text-underline-offset:4px;text-decoration-thickness:1px}.ds-resource-link:hover{color:var(--accent,#815716)}.ds-resource-link:focus-visible{outline:3px solid var(--focus,#9e6d20);outline-offset:5px;}@media(max-width:480px){.ds-resources{justify-content:flex-end;gap:10px 16px;font-size:12px}}@media print{.ds-resources{display:none}}"
    },
    {
      "name": "Guide jump navigation",
      "kind": "nav",
      "description": "The four jump groups of the existing nine-step guide.",
      "html": "<nav class=\"ds-contents\" aria-label=\"Guide sections\"><a class=\"ds-jump\" href=\"#ds-step-1\">1–4 &nbsp; Build &amp; name</a><a class=\"ds-jump\" href=\"#ds-step-5\">5–7 &nbsp; Connect &amp; run</a><a class=\"ds-jump\" href=\"#ds-step-8\">8 &nbsp; Take control</a><a class=\"ds-jump\" href=\"#ds-step-9\">9 &nbsp; Go further</a></nav>",
      "css": ".ds-contents{font-family:Inter,\"Segoe UI\",sans-serif;display:flex;flex-wrap:wrap;gap:10px 24px;border-top:1px solid var(--line,#d4dfe2);border-bottom:1px solid var(--line,#d4dfe2);padding:19px 0;margin-bottom:12px;font-size:13px;line-height:1.65}.ds-jump{color:var(--ink,#263e4b);text-decoration:none}.ds-jump:hover{color:var(--accent,#815716)}.ds-jump:focus-visible{outline:3px solid var(--focus,#9e6d20);outline-offset:5px;}@media(max-width:480px){.ds-contents{gap:10px 20px}}@media print{.ds-contents{display:none}}",
      "refersTo": "guide-navigation"
    },
    {
      "name": "Numbered guide step",
      "kind": "custom",
      "description": "The amber number rail and reading copy; this excerpt shows the first action.",
      "html": "<section class=\"ds-step\" id=\"ds-step-1\" aria-labelledby=\"ds-heading-1\"><span class=\"ds-number\" aria-hidden=\"true\">1</span><div class=\"ds-copy\"><h2 class=\"ds-heading\" id=\"ds-heading-1\">Place your first actuator</h2><p class=\"ds-paragraph\">Place a rotor on your grid. This first actuator will be the base of your arm.</p><p class=\"ds-secondary\">A hinge or piston can also be the first actuator. This guide uses a rotor.</p></div></section>",
      "css": ".ds-step{font-family:Inter,\"Segoe UI\",sans-serif;display:grid;grid-template-columns:44px minmax(0,1fr) minmax(0,1.12fr);column-gap:24px;align-items:start;padding:60px 0;border-bottom:1px solid var(--line,#d4dfe2);color:var(--ink,#263e4b);font-size:16px;line-height:1.65}.ds-number{font-family:Oxanium,sans-serif;color:var(--accent,#815716);font-size:25px;font-weight:500;line-height:1.3;padding-top:3px;font-variant-numeric:tabular-nums}.ds-heading{font-size:25px;font-weight:600;line-height:1.3;letter-spacing:-.02em;margin:0 0 17px;text-wrap:balance}.ds-paragraph{max-width:65ch;margin:0 0 16px}.ds-secondary{max-width:65ch;color:var(--muted,#496370);font-size:14px;margin:0}@media(max-width:800px){.ds-step{grid-template-columns:36px minmax(0,1fr);column-gap:16px;padding:44px 0}}@media(max-width:480px){.ds-step{grid-template-columns:28px minmax(0,1fr);column-gap:12px;padding:36px 0}.ds-heading{font-size:22px}.ds-number{font-size:23px}.ds-paragraph{font-size:15px}.ds-secondary{font-size:13px}}@media print{.ds-step{padding:24px 0;break-inside:avoid;font-size:10pt}.ds-heading{font-size:15pt}.ds-paragraph,.ds-secondary{font-size:10pt}}",
      "refersTo": "step-number"
    },
    {
      "name": "Endpoint name example",
      "kind": "custom",
      "description": "An exact naming example rendered as literal text rather than an editable field.",
      "html": "<div class=\"ds-name-example\"><span class=\"ds-example-label\">Example</span><code class=\"ds-name\">Arm 1 - Base</code></div>",
      "css": ".ds-name-example{font-family:Inter,\"Segoe UI\",sans-serif;margin:24px 0;color:var(--ink,#263e4b);line-height:1.65}.ds-example-label{display:block;color:var(--muted,#496370);font-size:13px;margin-bottom:7px}.ds-name{display:block;width:fit-content;font-family:\"Cascadia Mono\",Consolas,monospace;font-size:17px;background:var(--wash,#edf2f3);padding:10px 14px;border-radius:3px;overflow-wrap:anywhere}@media(max-width:480px){.ds-name{font-size:15px}}",
      "refersTo": "endpoint-example"
    },
    {
      "name": "Movement key",
