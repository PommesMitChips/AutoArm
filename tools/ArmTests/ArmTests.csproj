<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameBin Condition="'$(GameBin)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</GameBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="Sandbox.Common" HintPath="$(GameBin)/Sandbox.Common.dll" />
    <Reference Include="Sandbox.Game" HintPath="$(GameBin)/Sandbox.Game.dll" />
    <Reference Include="SpaceEngineers.Game" HintPath="$(GameBin)/SpaceEngineers.Game.dll" />
    <Reference Include="VRage" HintPath="$(GameBin)/VRage.dll" />
    <Reference Include="VRage.Game" HintPath="$(GameBin)/VRage.Game.dll" />
    <Reference Include="VRage.Library" HintPath="$(GameBin)/VRage.Library.dll" />
    <Reference Include="VRage.Math" HintPath="$(GameBin)/VRage.Math.dll" />
  </ItemGroup>
</Project>
