<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameBin Condition="'$(GameBin)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</GameBin>
  </PropertyGroup>
  <ItemGroup>
    <!-- This process must use the game's Roslyn, not ScriptPack's SDK Roslyn. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(GameBin)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(GameBin)/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
